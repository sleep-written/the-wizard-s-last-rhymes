{
    "compilerOptions": {
        "target": "es2025",
        "module": "node20",
        "moduleResolution": "node16",

        "strict": true,
        "sourceMap": true,
        "verbatimModuleSyntax": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,

        "outDir": "./dist",
        "rootDir": "./src",

        "types": [ "node" ],
        "paths": {
            "@data-source": [ "./src/data-source.ts" ],
            "@entities/*": [ "./src/entities/*" ]
        }
    }
}