{
  "name": "the-wizard-s-last-rhymes",
  "type": "module",
  "scripts": {
    "typeorm": "bleed start ./node_modules/typeorm/cli.js --",
    "start": "bleed start ./src/index.ts --",
    "build:cls": "rm -rf ./dist",
    "build:mts": "bleed build --config ./tsconfig.build.json",
    "build:chm": "chmod +x ./dist/index.js",
    "build": "node --run build:cls && node --run build:mts && node --run build:chm"
  },
  "bin": {
    "rhymes": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@bleed-believer/cli": "^1.1.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@bleed-believer/commander": "^2.1.1",
    "better-sqlite3": "^12.11.1",
    "typeorm": "^1.1.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
